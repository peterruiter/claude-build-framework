{
  "name": "video-tour",
  "private": true,
  "version": "1.0.0",
  "description": "Narrated feature tours of a web product from YAML scripts: Playwright recording, text-to-speech, branded cards, subtitles, manifest, self-hosted library and YouTube publishing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "video-tour": "src/cli.mjs"
  },
  "scripts": {
    "validate": "node src/cli.mjs validate",
    "example:validate": "node src/cli.mjs validate --config example/video-tour.config.json",
    "example:render": "node src/cli.mjs render all --no-voice --config example/video-tour.config.json"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
