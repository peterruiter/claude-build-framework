{
  "name": "app-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --config vite.portal.config.ts",
    "check": "node scripts/check-strings.mjs && node scripts/check-plurals.mjs --configured",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/*.test.*\"",
    "build": "npm run check && tsc -b && vite build && vite build --config vite.portal.config.ts",
    "add-language": "node scripts/add-language.mjs",
    "axe": "node scripts/axe-check.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
