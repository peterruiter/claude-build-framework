<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 so the plug-in runs on the same kind of runtime as in the sandbox. Runs on
    Windows (CI: windows-latest). Own small fakes instead of a mocking framework or FakeXrmEasy.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contoso.Sample.Plugins\Contoso.Sample.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied beside the tests, so they never have to find the repository by walking up. -->
    <None Include="..\..\build\contracts\registration.json" Link="Contracts\registration.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Contoso.Sample.Plugins\**\*.cs" Exclude="..\..\src\Contoso.Sample.Plugins\obj\**;..\..\src\Contoso.Sample.Plugins\bin\**" Link="Sources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Contoso.Sample.Plugins\Strings\*.json" Link="Strings\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
