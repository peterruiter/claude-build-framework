root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.cs]
# Analyzer levels come from AnalysisLevel in Directory.Build.props. Exceptions are listed here, each
# with its reason; never switch a rule off to make a build pass without one.

[tests/**.cs]
# Test names read as sentences.
dotnet_diagnostic.CA1707.severity = none
# Small constant arrays in assertions are clearer inline than as fields.
dotnet_diagnostic.CA1861.severity = none
# Fakes return the general type on purpose.
dotnet_diagnostic.CA1859.severity = none
