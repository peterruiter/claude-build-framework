{
  "name": "example-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "The Android and iOS app: a Capacitor shell around the web app.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/write-server.mjs && cap sync",
    "sync:android": "node scripts/write-server.mjs && cap sync android",
    "sync:ios": "node scripts/write-server.mjs && cap sync ios",
    "assets": "capacitor-assets generate --android --ios --assetPath assets --iconBackgroundColor \"#ffffff\" --splashBackgroundColor \"#ffffff\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "typescript": "5.9.3"
  }
}
